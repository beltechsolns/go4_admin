PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/g4delivery
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Email (Gmail app password) — used for password reset
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=G4 Delivery <youraddress@gmail.com>

# Base URL of the app's reset-password screen (the link sent in the email)
APP_BASE_URL=https://go4-app.example.com

# Optional: admin web URL for admin reset emails (defaults to FRONTEND_URL)
ADMIN_APP_BASE_URL=http://localhost:5173

# Supabase Storage — uploads persist across deploys. Without these, files fall back to the ephemeral /uploads/ folder.
# From Supabase dashboard: Project Settings -> API
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Bucket 'delivery-images' (public) must exist. Get URL from dashboard, use Service Role key to upload.

# Firebase Cloud Messaging (push notifications)
# Option A: paste the full service account JSON as a single line (recommended for Render)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}
# Alternate: single var accepted by the server. Can be the JSON string or a path to a service account file
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}
# or
# FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json
# Option B: individual fields (private key must use \n for newlines)
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
